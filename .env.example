# Copy this file to .env and fill in local credentials.

# Search service
SERPER_API_KEY=

# Shared LLM defaults
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_BASE_URL=
DEFAULT_CHAT_MODEL=chat-model-placeholder
DEFAULT_VISION_MODEL=vision-model-placeholder
DEFAULT_EMBEDDING_MODEL=embedding-model-placeholder

# Optional per-role overrides
WRITER_MODEL=
WRITER_API_KEY=
WRITER_BASEURL=
CODER_MODEL=
CODER_API_KEY=
CODER_BASEURL=
PLANNER_MODEL=
PLANNER_API_KEY=
PLANNER_BASEURL=
ANALYZER_MODEL=
ANALYZER_API_KEY=
ANALYZER_BASEURL=
EXTRACTOR_MODEL=
EXTRACTOR_API_KEY=
EXTRACTOR_BASEURL=
EMBEDDING_API_KEY=
EMBEDDING_BASEURL=
EMBEDDING_DIMENSIONS=1024

# Data paths
INSTANCE_FILE_PATH=./data/databases/all_table_infos.json
INSTANCE_INDEX_PATH=./data/databases/tables
NLTK_DATA_PATH=./nltk_data
CHECKPOINTS_PATH=./data/databases/checkpoints.db

# Runtime settings
LANGSMITH_PROJECT=kdr
SEED=42
MAX_OUTPUT_RETRY=2
TOTAL_TOOL_CALL=30
WEB_SEARCH_TOP_K=5
INSTANCE_TOP_K=5
INSTANCE_SELECTION_K=1
INSTANCE_SCORE_THRESHOLD=-1.0
